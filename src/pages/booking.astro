            </label>

            <!-- Option B: Direct WhatsApp OpenGraph Manual -->
            <label class="channel-card relative flex flex-col p-5 rounded-2xl border border-[#E8DFD5] bg-white cursor-pointer transition-all hover:shadow-md">
              <div class="flex items-start justify-between mb-3">
                <div class="flex items-center gap-3">
                  <div class="size-10 rounded-xl bg-[#25D366] text-white flex items-center justify-center">
                    <span class="material-symbols-outlined text-[22px]">chat</span>
                  </div>
                  <div>
                    <h3 class="font-serif text-base font-bold text-[#1A1816]">Chat WhatsApp Manual</h3>
                    <span class="inline-block px-2 py-0.5 rounded-full bg-[#F3ECE3] text-[#5C544E] text-[10px] font-bold uppercase tracking-wider">OpenGraph Direct</span>
