    </div>

  </div>

  <!-- ================================================================= -->
  <!-- MODAL KONFIRMASI BERHASIL / TIKET RESERVASI DIGITAL -->
  <!-- ================================================================= -->
  <div 
    id="bookingSuccessModal" 
    class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4 sm:p-6"
    role="dialog" 
    aria-modal="true"
  >
    <div class="w-full max-w-lg bg-white rounded-3xl p-6 sm:p-8 shadow-2xl border border-[#E8DFD5] relative animate-fade-in">
      
      <!-- Top Decorative Ribbon & Close -->
      <div class="flex items-center justify-between pb-4 border-b border-[#E8DFD5]">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-green-100 text-green-800 text-xs font-bold">
          <span class="material-symbols-outlined text-[16px]">check_circle</span>
          <span>Reservasi Berhasil Diajukan</span>
        </div>
        <button id="closeModalBtn" class="size-8 rounded-full bg-[#F3ECE3] hover:bg-[#E8DFD5] text-[#1A1816] flex items-center justify-center cursor-pointer transition-all">
          <span class="material-symbols-outlined text-[18px]">close</span>
        </button>
      </div>

      <!-- Modal Body (Digital Ticket View) -->
      <div class="py-6 text-center">
        <div class="size-16 rounded-full bg-[#FAF2EB] text-[#7F513C] flex items-center justify-center mx-auto mb-4 border-2 border-[#7F513C]/20">
          <span class="material-symbols-outlined text-[36px]">confirmation_number</span>
        </div>
        
        <h3 class="font-serif text-2xl font-bold text-[#1A1816] mb-1">Terima Kasih, <span id="modalGuestName">Tamu</span>!</h3>
        <p class="text-xs sm:text-sm text-[#5C544E] max-w-sm mx-auto mb-5">
          Jadwal Anda telah tercatat resmi di sistem salon Sonae Beauty Studio Madiun.
        </p>

        <!-- Digital Booking Code Card -->
        <div class="p-4 rounded-2xl bg-[#FBF8F4] border border-[#E8DFD5] mb-5 text-left">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-bold text-[#8E847C] uppercase tracking-wider">KODE RESERVASI RESMI</span>
            <span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 text-[10px] font-bold">Menunggu Konfirmasi</span>
          </div>
          <div class="flex items-center justify-between gap-2 bg-white p-3 rounded-xl border border-[#E8DFD5]">
            <span id="modalBookingCode" class="font-mono text-lg sm:text-xl font-bold text-[#7F513C] tracking-wider">SN-20251018-0000</span>
            <button id="copyCodeBtn" class="px-3 py-1.5 rounded-lg bg-[#FAF2EB] hover:bg-[#E8DFD5] text-[#7F513C] text-xs font-bold transition-all flex items-center gap-1 cursor-pointer">
              <span class="material-symbols-outlined text-[14px]">content_copy</span>
              <span id="copyBtnText">Salin</span>
            </button>
          </div>

          <!-- Schedule & Summary in Ticket -->
          <div class="mt-4 pt-3 border-t border-[#E8DFD5] space-y-1.5 text-xs text-[#5C544E]">
            <div class="flex justify-between">
              <span>Jadwal:</span>
              <strong id="modalSchedule" class="text-[#1A1816]">Sabtu, 18 Oktober 2025 (13:00 WIB)</strong>
            </div>
            <div class="flex justify-between">
              <span>Layanan:</span>
              <strong id="modalServices" class="text-[#1A1816] text-right truncate max-w-[200px]">Korean Smoothing</strong>
            </div>
            <div class="flex justify-between">
              <span>Estimasi Biaya:</span>
              <strong id="modalTotal" class="text-[#7F513C] font-bold">Rp 435.000</strong>
            </div>
          </div>
        </div>

        <!-- Action Buttons in Modal -->
        <div class="space-y-2.5">
          <!-- WhatsApp Forward Button -->
          <button 
            id="modalNotifyWaBtn"
            class="w-full py-3.5 px-4 rounded-xl bg-[#25D366] hover:bg-[#20bd5a] text-white font-bold text-xs sm:text-sm flex items-center justify-center gap-2 shadow-sm transition-all cursor-pointer"
          >
            <span class="material-symbols-outlined text-[18px]">chat</span>
            <span>Kirim Notifikasi Cepat ke WhatsApp Admin</span>
          </button>

          <div class="grid grid-cols-2 gap-2">
            <!-- Print Ticket Button -->
            <button 
              id="modalPrintBtn"
              class="py-2.5 px-3 rounded-xl bg-[#F3ECE3] hover:bg-[#E8DFD5] text-[#1A1816] font-bold text-xs flex items-center justify-center gap-1.5 transition-all cursor-pointer"
            >
              <span class="material-symbols-outlined text-[16px]">print</span>
              <span>Cetak Tiket</span>
            </button>

            <!-- Go to Admin Dashboard Link -->
            <a 
              href="/admin" 
              class="py-2.5 px-3 rounded-xl border border-[#E8DFD5] hover:bg-[#FAF2EB] text-[#7F513C] font-bold text-xs flex items-center justify-center gap-1.5 transition-all"
            >
              <span class="material-symbols-outlined text-[16px]">admin_panel_settings</span>
              <span>Buka Dashboard</span>
            </a>
          </div>
        </div>

      </div>

    </div>
  </div>

</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Set default date to today
    const dateInput = document.getElementById('bookingDateInput') as HTMLInputElement;
    const summaryDate = document.getElementById('summaryDate');
    const summaryTime = document.getElementById('summaryTime');
    const summaryTotal = document.getElementById('summaryTotal');
    const summaryServicesList = document.getElementById('summaryServicesList');

    if (dateInput) {
      const today = new Date();
      const yyyy = today.getFullYear();
      const mm = String(today.getMonth() + 1).padStart(2, '0');
      const dd = String(today.getDate()).padStart(2, '0');
      dateInput.min = `${yyyy}-${mm}-${dd}`;
      dateInput.value = `${yyyy}-${mm}-${dd}`;

      dateInput.addEventListener('change', () => {
        if (summaryDate && dateInput.value) {
          const d = new Date(dateInput.value);
          const options: Intl.DateTimeFormatOptions = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
          summaryDate.textContent = d.toLocaleDateString('id-ID', options);
        }
      });
    }

    // 2. Time Slot Selection
    const timeSlots = document.querySelectorAll('.time-slot-btn');
    timeSlots.forEach(slot => {
      slot.addEventListener('click', () => {
        timeSlots.forEach(s => {
          s.classList.remove('active', 'border-2', 'border-[#7F513C]', 'bg-[#FAF2EB]', 'text-[#7F513C]');
          s.classList.add('border', 'border-[#E8DFD5]', 'text-[#1A1816]');
        });
        slot.classList.add('active', 'border-2', 'border-[#7F513C]', 'bg-[#FAF2EB]', 'text-[#7F513C]');
        slot.classList.remove('border', 'border-[#E8DFD5]', 'text-[#1A1816]');
        const timeVal = slot.getAttribute('data-time');
        if (summaryTime && timeVal) {
          summaryTime.textContent = `Pukul ${timeVal}`;
        }
      });
    });

    // 3. Category Filter for Services
    const catBtns = document.querySelectorAll('.service-cat-btn');
    const serviceCards = document.querySelectorAll('.service-card');
    catBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        catBtns.forEach(b => {
          b.classList.remove('active', 'bg-[#7F513C]', 'text-white');
          b.classList.add('bg-[#F3ECE3]', 'text-[#5C544E]');
        });
        btn.classList.add('active', 'bg-[#7F513C]', 'text-white');
        btn.classList.remove('bg-[#F3ECE3]', 'text-[#5C544E]');

        const cat = btn.getAttribute('data-cat');
        serviceCards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (cat === 'all' || cardCat === cat) {
            (card as HTMLElement).style.display = 'block';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    // 4. Update Summary on Service Selection
    let calculatedTotal = 435000;
    function updateSummary() {
      const checkedCards = document.querySelectorAll('.service-card input.service-checkbox:checked');
      let total = 0;
      let html = '';

      checkedCards.forEach(chk => {
        const card = chk.closest('.service-card');
        if (card) {
          const name = card.getAttribute('data-name') || '';
          const price = parseInt(card.getAttribute('data-price') || '0', 10);
          total += price;
          html += `
            <div class="flex items-center justify-between text-xs py-1">
              <span class="font-semibold text-[#1A1816] truncate max-w-[170px]">${name}</span>
              <span class="font-bold text-[#7F513C]">Rp ${price.toLocaleString('id-ID')}</span>
            </div>
          `;
        }
      });

      calculatedTotal = total;
      if (summaryServicesList) {
        summaryServicesList.innerHTML = html || '<span class="text-xs text-[#8E847C]">Belum ada layanan dipilih</span>';
      }
      if (summaryTotal) {
        summaryTotal.textContent = `Rp ${total.toLocaleString('id-ID')}`;
      }
    }

    document.querySelectorAll('.service-checkbox').forEach(chk => {
      chk.addEventListener('change', (e) => {
        const card = (e.target as HTMLElement).closest('.service-card');
        if (card) {
          if ((e.target as HTMLInputElement).checked) {
            card.classList.add('border-2', 'border-[#7F513C]', 'bg-[#FAF2EB]/40');
            card.classList.remove('border-[#E8DFD5]', 'bg-white');
          } else {
            card.classList.remove('border-2', 'border-[#7F513C]', 'bg-[#FAF2EB]/40');
            card.classList.add('border-[#E8DFD5]', 'bg-white');
          }
        }
        updateSummary();
      });
    });

    // 5. Booking Channel Selector Switcher (Dashboard vs WhatsApp Manual)
    const channelRadios = document.querySelectorAll('input[name="bookingChannel"]');
    const channelCards = document.querySelectorAll('.channel-card');
    const confirmBtn = document.getElementById('confirmBookingBtn');
    const confirmBtnText = document.getElementById('confirmBtnText');
    const confirmBtnIcon = document.getElementById('confirmBtnIcon');
    const channelBadgeIndicator = document.getElementById('channelBadgeIndicator');

    let currentChannel = 'dashboard';

    function setChannel(channel: string) {
      currentChannel = channel;
      channelCards.forEach(card => {
        const radio = card.querySelector('input[type="radio"]') as HTMLInputElement;
        if (radio && radio.value === channel) {
          radio.checked = true;
          card.classList.add('border-2', 'border-[#7F513C]', 'bg-[#FAF2EB]/40');
          card.classList.remove('border-[#E8DFD5]', 'bg-white');
        } else {
          card.classList.remove('border-2', 'border-[#7F513C]', 'bg-[#FAF2EB]/40');
          card.classList.add('border-[#E8DFD5]', 'bg-white');
        }
      });

      if (channel === 'dashboard') {
        if (confirmBtn) {
          confirmBtn.className = "w-full py-4 rounded-xl bg-[#7F513C] hover:bg-[#633B2A] text-white font-bold text-sm sm:text-base flex items-center justify-center gap-2 shadow-pill-button transition-all duration-200 active:opacity-90 cursor-pointer";
        }
        if (confirmBtnText) confirmBtnText.textContent = "Konfirmasi & Masuk Dashboard";
        if (confirmBtnIcon) confirmBtnIcon.textContent = "confirmation_number";
        if (channelBadgeIndicator) {
          channelBadgeIndicator.textContent = "Dashboard Admin";
          channelBadgeIndicator.className = "px-2.5 py-0.5 rounded-full bg-[#FAF2EB] text-[#7F513C] text-[10px] font-bold";
        }
      } else {
        if (confirmBtn) {
          confirmBtn.className = "w-full py-4 rounded-xl bg-[#25D366] hover:bg-[#20bd5a] text-white font-bold text-sm sm:text-base flex items-center justify-center gap-2 shadow-sm transition-all duration-200 active:opacity-90 cursor-pointer";
        }
        if (confirmBtnText) confirmBtnText.textContent = "Kirim via WhatsApp (OpenGraph)";
        if (confirmBtnIcon) confirmBtnIcon.textContent = "chat";
        if (channelBadgeIndicator) {
          channelBadgeIndicator.textContent = "WhatsApp OpenGraph";
          channelBadgeIndicator.className = "px-2.5 py-0.5 rounded-full bg-green-100 text-green-800 text-[10px] font-bold";
        }
      }
    }

    channelRadios.forEach(radio => {
      radio.addEventListener('change', (e) => {
        setChannel((e.target as HTMLInputElement).value);
      });
    });

    channelCards.forEach(card => {
      card.addEventListener('click', () => {
        const radio = card.querySelector('input[type="radio"]') as HTMLInputElement;
        if (radio) {
          setChannel(radio.value);
        }
      });
    });

    // 6. Modal Elements
    const successModal = document.getElementById('bookingSuccessModal');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const modalGuestName = document.getElementById('modalGuestName');
    const modalBookingCode = document.getElementById('modalBookingCode');
    const modalSchedule = document.getElementById('modalSchedule');
    const modalServices = document.getElementById('modalServices');
    const modalTotal = document.getElementById('modalTotal');
    const modalNotifyWaBtn = document.getElementById('modalNotifyWaBtn');
    const copyCodeBtn = document.getElementById('copyCodeBtn');
    const copyBtnText = document.getElementById('copyBtnText');
    const modalPrintBtn = document.getElementById('modalPrintBtn');

    if (closeModalBtn && successModal) {
      closeModalBtn.addEventListener('click', () => {
        successModal.classList.add('hidden');
        successModal.classList.remove('flex');
      });
    }

    if (copyCodeBtn && modalBookingCode && copyBtnText) {
      copyCodeBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(modalBookingCode.textContent || '');
        copyBtnText.textContent = 'Tersalin!';
        setTimeout(() => {
          if (copyBtnText) copyBtnText.textContent = 'Salin';
        }, 2000);
      });
    }

    if (modalPrintBtn) {
      modalPrintBtn.addEventListener('click', () => {
        window.print();
      });
    }

    // 7. Save Booking Function to LocalStorage (Synced with Admin Dashboard)
    function saveBookingRecord(record: any) {
      try {
        const stored = localStorage.getItem('sonae_bookings');
        const bookings = stored ? JSON.parse(stored) : [];
        bookings.unshift(record);
        localStorage.setItem('sonae_bookings', JSON.stringify(bookings));
      } catch (err) {
        console.error('Error saving booking:', err);
      }
    }

    // 8. Booking Submission Handler
    if (confirmBtn) {
      confirmBtn.addEventListener('click', () => {
        const nameInput = document.getElementById('guestNameInput') as HTMLInputElement;
        const phoneInput = document.getElementById('guestPhoneInput') as HTMLInputElement;
        const noteInput = document.getElementById('guestNoteInput') as HTMLTextAreaElement;

        const name = nameInput?.value.trim();
        const phone = phoneInput?.value.trim();
        const note = noteInput?.value.trim() || '-';
        const date = summaryDate?.textContent || 'Jadwal fleksibel';
        const time = summaryTime?.textContent || '13:00 WIB';

        if (!name) {
          alert('Silakan isi Nama Lengkap Anda terlebih dahulu.');
          nameInput?.focus();
          return;
        }

        if (!phone || phone.length < 9) {
          alert('Silakan isi Nomor WhatsApp Aktif Anda yang valid.');
          phoneInput?.focus();
          return;
        }

        const selectedServices: string[] = [];
        document.querySelectorAll('.service-card input.service-checkbox:checked').forEach(chk => {
          const card = chk.closest('.service-card');
          if (card) {
            selectedServices.push(card.getAttribute('data-name') || '');
          }
        });

        if (selectedServices.length === 0) {
          alert('Silakan pilih minimal satu layanan terlebih dahulu!');
          return;
        }

        // Generate unique booking code
        const now = new Date();
        const y = now.getFullYear();
        const m = String(now.getMonth() + 1).padStart(2, '0');
        const d = String(now.getDate()).padStart(2, '0');
        const randomNum = Math.floor(1000 + Math.random() * 9000);
        const bookingCode = `SN-${y}${m}${d}-${randomNum}`;

        const bookingData = {
          id: 'bk_' + Date.now(),
          code: bookingCode,
          guestName: name,
          guestPhone: phone,
          guestNote: note,
          services: selectedServices,
          total: calculatedTotal,
          dateText: date,
          timeText: time,
          channel: currentChannel,
          status: 'Menunggu Konfirmasi',
          createdAt: new Date().toISOString()
        };

        // Always save to storage so admin dashboard has real-time incoming records
        saveBookingRecord(bookingData);

        // Preformatted WhatsApp message
        const waMsg = 
`Halo Sonae Beauty Studio Madiun! 👋
Saya ingin mengonfirmasi reservasi perawatan:

🔖 *Kode Reservasi:* ${bookingCode}
📋 *Layanan:* ${selectedServices.join(', ')}
📅 *Tanggal:* ${date}
⏰ *Waktu:* ${time}
💰 *Total Estimasi:* Rp ${calculatedTotal.toLocaleString('id-ID')}

👤 *Nama Tamu:* ${name}
📱 *No. WhatsApp:* ${phone}
📝 *Catatan:* ${note}

🌐 *Tautan Reservasi:* https://sonaebeauty.reaksy.com/booking
Mohon konfirmasi ketersediaan slotnya ya. Terima kasih! ✨`;

        const waUrl = `https://wa.me/6285743463333?text=${encodeURIComponent(waMsg)}`;

        if (currentChannel === 'whatsapp') {
          // Open WhatsApp Manual Directly with OpenGraph link
          window.open(waUrl, '_blank');
        } else {
          // Open Digital Ticket Modal for Admin Dashboard method
          if (modalGuestName) modalGuestName.textContent = name;
          if (modalBookingCode) modalBookingCode.textContent = bookingCode;
          if (modalSchedule) modalSchedule.textContent = `${date} (${time})`;
          if (modalServices) modalServices.textContent = selectedServices.join(', ');
          if (modalTotal) modalTotal.textContent = `Rp ${calculatedTotal.toLocaleString('id-ID')}`;

          if (modalNotifyWaBtn) {
            modalNotifyWaBtn.onclick = () => {
              window.open(waUrl, '_blank');
            };
          }

          if (successModal) {
            successModal.classList.remove('hidden');
            successModal.classList.add('flex');
          }
        }
      });
    }
  });
</script>
