<script>
  import * as XLSX from 'xlsx';

  interface BookingItem {
    id: string;
    code: string;
    guestName: string;
    guestPhone: string;
    guestNote: string;
    services: string[];
    total: number;
    dateText: string;
    timeText: string;
    channel: string;
    status: 'Menunggu Konfirmasi' | 'Terkonfirmasi' | 'Selesai' | 'Dibatalkan';
    createdAt: string;
  }

  // Realistic sample seed data if localStorage is empty
  const SAMPLE_BOOKINGS: BookingItem[] = [
    {
      id: 'bk_sample_1',
      code: 'SN-20251018-8421',
      guestName: 'Anindya Larasati',
      guestPhone: '081234567890',
      guestNote: 'Rambut tebal sebahu, request terapis Kak Nadia.',
      services: ['Korean Keratin Smoothing & Haircut'],
      total: 435000,
      dateText: 'Sabtu, 18 Oktober 2025',
      timeText: '13:00 WIB',
      channel: 'dashboard',
      status: 'Menunggu Konfirmasi',
      createdAt: new Date(Date.now() - 3600000).toISOString()
    },
    {
      id: 'bk_sample_2',
      code: 'SN-20251018-9102',
      guestName: 'Dinda Rahmadani',
      guestPhone: '085732198765',
      guestNote: 'Ingin nail art gradasi nude & glitter.',
      services: ['Japanese Custom Nail Art'],
      total: 175000,
      dateText: 'Sabtu, 18 Oktober 2025',
      timeText: '14:30 WIB',
      channel: 'whatsapp',
      status: 'Terkonfirmasi',
      createdAt: new Date(Date.now() - 7200000).toISOString()
    },
    {
      id: 'bk_sample_3',
      code: 'SN-20251019-1234',
      guestName: 'Siti Sarah Wardoyo',
      guestPhone: '082199887766',
      guestNote: 'Booking untuk 2 orang (Lash lift + Head spa)',
      services: ['Keratin Lash Lift & Tint', 'Scalp Detox & Japanese Head Spa'],
      total: 330000,
      dateText: 'Minggu, 19 Oktober 2025',
      timeText: '10:00 WIB',
      channel: 'dashboard',
      status: 'Terkonfirmasi',
      createdAt: new Date(Date.now() - 14400000).toISOString()
    },
    {
      id: 'bk_sample_4',
      code: 'SN-20251017-5561',
      guestName: 'Jessica Aurelia',
      guestPhone: '087811223344',
      guestNote: 'Puas sekali dengan hasil smoothing sebelumnya.',
      services: ['Signature Korean Haircut & Blowdry'],
      total: 85000,
      dateText: 'Jumat, 17 Oktober 2025',
      timeText: '16:00 WIB',
      channel: 'dashboard',
      status: 'Selesai',
      createdAt: new Date(Date.now() - 86400000).toISOString()
    }
  ];

  document.addEventListener('DOMContentLoaded', () => {
    // =================================================================
    // AUTHENTICATION & LOGIN GATE LOGIC
    // =================================================================
    const loginScreen = document.getElementById('adminLoginScreen');
    const dashboardScreen = document.getElementById('adminDashboardScreen');
    const loginForm = document.getElementById('adminLoginForm') as HTMLFormElement;
    const loginUsername = document.getElementById('loginUsername') as HTMLInputElement;
    const loginPassword = document.getElementById('loginPassword') as HTMLInputElement;
    const rememberMeCheckbox = document.getElementById('rememberMeCheckbox') as HTMLInputElement;
    const loginErrorAlert = document.getElementById('loginErrorAlert');
    const togglePasswordBtn = document.getElementById('togglePasswordBtn');
    const passwordToggleIcon = document.getElementById('passwordToggleIcon');
    const quickAutofillBtn = document.getElementById('quickAutofillBtn');
    const logoutBtn = document.getElementById('adminLogoutBtn');

    // Check existing session
    function isAuthenticated(): boolean {
      return (
        localStorage.getItem('sonae_admin_auth') === 'true' ||
        sessionStorage.getItem('sonae_admin_auth') === 'true'
      );
    }

    function showDashboard() {
      if (loginScreen) loginScreen.classList.add('hidden');
      if (dashboardScreen) dashboardScreen.classList.remove('hidden');
      startLiveClock();
    }

    function showLogin() {
      if (dashboardScreen) dashboardScreen.classList.add('hidden');
      if (loginScreen) loginScreen.classList.remove('hidden');
      if (loginPassword) loginPassword.value = '';
    }

    if (isAuthenticated()) {
      showDashboard();
    } else {
      showLogin();
    }

    // Toggle Password Visibility
    if (togglePasswordBtn && loginPassword && passwordToggleIcon) {
      togglePasswordBtn.addEventListener('click', () => {
        const isPassword = loginPassword.type === 'password';
        loginPassword.type = isPassword ? 'text' : 'password';
        passwordToggleIcon.textContent = isPassword ? 'visibility_off' : 'visibility';
      });
    }

    // Quick Autofill Demo Credentials
    if (quickAutofillBtn && loginUsername && loginPassword) {
      quickAutofillBtn.addEventListener('click', () => {
        loginUsername.value = 'admin';
        loginPassword.value = 'sonae2025';
        submitLogin('admin', 'sonae2025');
      });
    }

    // Handle Login Submission
    function submitLogin(u: string, p: string) {
      const user = u.trim().toLowerCase();
      const pass = p.trim();

      // Accepted staff credentials
      const isValid = 
        (user === 'admin' && (pass === 'sonae2025' || pass === 'admin123')) ||
        (user === 'kasir' && (pass === 'sonae2025' || pass === 'kasir123')) ||
        (user === 'admin@sonaebeauty.com' && pass === 'sonae2025');

      if (isValid) {
        if (loginErrorAlert) loginErrorAlert.classList.add('hidden');
        const remember = rememberMeCheckbox?.checked;
        if (remember) {
          localStorage.setItem('sonae_admin_auth', 'true');
        } else {
          sessionStorage.setItem('sonae_admin_auth', 'true');
        }
        showDashboard();
      } else {
        if (loginErrorAlert) {
          loginErrorAlert.classList.remove('hidden');
          // Shake effect
          loginErrorAlert.classList.add('animate-bounce');
          setTimeout(() => loginErrorAlert.classList.remove('animate-bounce'), 800);
        }
      }
    }

    if (loginForm) {
      loginForm.addEventListener('submit', (e) => {
        e.preventDefault();
        submitLogin(loginUsername?.value || '', loginPassword?.value || '');
      });
    }

    // Handle Logout
    if (logoutBtn) {
      logoutBtn.addEventListener('click', () => {
        if (confirm('Yakin ingin keluar dari sesi Dashboard Kasir Sonae?')) {
          localStorage.removeItem('sonae_admin_auth');
          sessionStorage.removeItem('sonae_admin_auth');
          showLogin();
        }
      });
    }

    // Live Real-time Clock (WIB)
    function startLiveClock() {
      const clockEl = document.getElementById('liveClockWib');
      function update() {
        if (clockEl) {
          const now = new Date();
          clockEl.textContent = now.toLocaleTimeString('id-ID') + ' WIB';
        }
      }
      update();
      setInterval(update, 1000);
    }

    // =================================================================
    // DASHBOARD DATA MANAGEMENT (BOOKINGS, FILTERS, EXPORT)
    // =================================================================
    let bookings: BookingItem[] = [];

    function loadBookings(): BookingItem[] {
      try {
        const data = localStorage.getItem('sonae_bookings');
        if (data) {
          return JSON.parse(data);
        } else {
          localStorage.setItem('sonae_bookings', JSON.stringify(SAMPLE_BOOKINGS));
          return [...SAMPLE_BOOKINGS];
        }
      } catch (err) {
        console.error('Error loading bookings:', err);
        return [...SAMPLE_BOOKINGS];
      }
    }

    function saveBookings() {
      try {
        localStorage.setItem('sonae_bookings', JSON.stringify(bookings));
      } catch (err) {
        console.error('Error saving bookings:', err);
      }
    }

    bookings = loadBookings();

    // DOM References
    const tableBody = document.getElementById('bookingsTableBody');
    const emptyState = document.getElementById('emptyStateContainer');
    const bookingsTable = document.getElementById('bookingsTable');
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const channelFilter = document.getElementById('channelFilter') as HTMLSelectElement;
    const statusTabs = document.querySelectorAll('.status-tab');
    const resetFilterBtn = document.getElementById('resetFilterBtn');
    const filteredCountBadge = document.getElementById('filteredCountBadge');

    // KPI Counters
    const statTotal = document.getElementById('statTotalBookings');
    const statPending = document.getElementById('statPendingBookings');
    const statConfirmed = document.getElementById('statConfirmedBookings');
    const statCompleted = document.getElementById('statCompletedBookings');
    const statRevenue = document.getElementById('statEstimatedRevenue');

    // Tab Counters
    const countTabAll = document.getElementById('countTabAll');
    const countTabPending = document.getElementById('countTabPending');
    const countTabConfirmed = document.getElementById('countTabConfirmed');
    const countTabCompleted = document.getElementById('countTabCompleted');
    const countTabCancelled = document.getElementById('countTabCancelled');

    let currentStatusFilter = 'all';
    let currentSearchQuery = '';
    let currentChannelFilter = 'all';

    function updateKPIs() {
      const total = bookings.length;
      const pending = bookings.filter(b => b.status === 'Menunggu Konfirmasi').length;
      const confirmed = bookings.filter(b => b.status === 'Terkonfirmasi').length;
      const completed = bookings.filter(b => b.status === 'Selesai').length;
      const cancelled = bookings.filter(b => b.status === 'Dibatalkan').length;
      const totalRev = bookings.filter(b => b.status !== 'Dibatalkan').reduce((sum, b) => sum + (b.total || 0), 0);

      if (statTotal) statTotal.textContent = String(total);
      if (statPending) statPending.textContent = String(pending);
      if (statConfirmed) statConfirmed.textContent = String(confirmed);
      if (statCompleted) statCompleted.textContent = String(completed);
      if (statRevenue) statRevenue.textContent = `Rp ${totalRev.toLocaleString('id-ID')}`;

      if (countTabAll) countTabAll.textContent = String(total);
      if (countTabPending) countTabPending.textContent = String(pending);
      if (countTabConfirmed) countTabConfirmed.textContent = String(confirmed);
      if (countTabCompleted) countTabCompleted.textContent = String(completed);
      if (countTabCancelled) countTabCancelled.textContent = String(cancelled);
    }

    function renderTable() {
      if (!tableBody) return;

      const filtered = bookings.filter(b => {
        if (currentStatusFilter !== 'all' && b.status !== currentStatusFilter) return false;
        if (currentChannelFilter !== 'all' && b.channel !== currentChannelFilter) return false;

        if (currentSearchQuery) {
          const q = currentSearchQuery.toLowerCase();
          const matchName = b.guestName.toLowerCase().includes(q);
          const matchPhone = b.guestPhone.toLowerCase().includes(q);
          const matchCode = b.code.toLowerCase().includes(q);
          const matchService = b.services.join(' ').toLowerCase().includes(q);
          if (!matchName && !matchPhone && !matchCode && !matchService) return false;
        }

        return true;
      });

      if (filteredCountBadge) {
        filteredCountBadge.textContent = `Menampilkan ${filtered.length} dari ${bookings.length} reservasi`;
      }

      if (filtered.length === 0) {
        if (emptyState) emptyState.classList.remove('hidden');
        if (bookingsTable) bookingsTable.classList.add('hidden');
        tableBody.innerHTML = '';
        return;
      }

      if (emptyState) emptyState.classList.add('hidden');
      if (bookingsTable) bookingsTable.classList.remove('hidden');

      let html = '';
      filtered.forEach(item => {
        let statusClass = 'bg-amber-100 text-amber-800 border-amber-300';
        if (item.status === 'Terkonfirmasi') statusClass = 'bg-blue-100 text-blue-800 border-blue-300';
        if (item.status === 'Selesai') statusClass = 'bg-green-100 text-green-800 border-green-300';
        if (item.status === 'Dibatalkan') statusClass = 'bg-red-100 text-red-800 border-red-300';

        const isDashboard = item.channel === 'dashboard';
        const channelBadge = isDashboard
          ? `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-[#FAF2EB] text-[#7F513C] text-[10px] font-bold">
              <span class="material-symbols-outlined text-[12px]">database</span>
              <span>Web Admin</span>
            </span>`
          : `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-green-100 text-green-800 text-[10px] font-bold">
              <span class="material-symbols-outlined text-[12px]">chat</span>
              <span>WA Direct</span>
            </span>`;

        const replyMsg = `Halo Kak ${item.guestName}! 👋
Kami dari *Sonae Beauty Studio Madiun*.

Mengenai reservasi perawatan:
🔖 *Kode Reservasi:* ${item.code}
📅 *Jadwal:* ${item.dateText} (${item.timeText})
📋 *Layanan:* ${item.services.join(', ')}

${item.status === 'Terkonfirmasi' 
  ? 'Status reservasi Anda telah *TERKONFIRMASI*. Kami siap menyambut kehadiran Anda di studio kami di Jl. Thamrin, Madiun! ✨' 
  : 'Kami ingin mengonfirmasi ketersediaan slot Anda. Apakah jadwal ini sudah sesuai Kak? Terima kasih! ✨'}`;

        const cleanPhone = item.guestPhone.replace(/[^0-9]/g, '');
        const intlPhone = cleanPhone.startsWith('0') ? '62' + cleanPhone.slice(1) : cleanPhone;
        const waUrl = `https://wa.me/${intlPhone}?text=${encodeURIComponent(replyMsg)}`;

        html += `
          <tr class="hover:bg-[#FAF2EB]/30 transition-colors" data-id="${item.id}">
            <td class="py-4 px-4 sm:px-6">
              <span class="font-mono font-bold text-[#7F513C] block">${item.code}</span>
              <span class="text-[10px] text-[#8E847C] block mt-0.5">
                ${new Date(item.createdAt).toLocaleDateString('id-ID', { hour: '2-digit', minute: '2-digit' })}
              </span>
            </td>

            <td class="py-4 px-4">
              <span class="font-bold text-[#1A1816] block">${item.guestName}</span>
              <div class="flex items-center gap-1 text-[11px] text-[#5C544E] mt-0.5">
                <span class="material-symbols-outlined text-[13px] text-[#25D366]">chat</span>
                <a href="${waUrl}" target="_blank" class="hover:text-[#7F513C] underline">${item.guestPhone}</a>
              </div>
              ${item.guestNote && item.guestNote !== '-' ? `<span class="text-[10px] text-[#8E847C] italic block truncate max-w-[160px] mt-0.5">"${item.guestNote}"</span>` : ''}
            </td>

            <td class="py-4 px-4">
              <span class="font-semibold text-[#1A1816] block max-w-[180px] truncate">${item.services.join(', ')}</span>
              <span class="font-bold text-[#7F513C] text-xs block mt-0.5">Rp ${item.total.toLocaleString('id-ID')}</span>
            </td>

            <td class="py-4 px-4">
              <span class="font-semibold text-[#1A1816] block text-xs">${item.dateText}</span>
              <span class="text-[11px] text-[#5C544E] block">${item.timeText}</span>
            </td>

            <td class="py-4 px-4">
              ${channelBadge}
            </td>

            <td class="py-4 px-4">
              <select class="status-select px-2.5 py-1 rounded-lg border text-[11px] font-bold ${statusClass} focus:outline-none cursor-pointer" data-id="${item.id}">
                <option value="Menunggu Konfirmasi" ${item.status === 'Menunggu Konfirmasi' ? 'selected' : ''}>Menunggu</option>
                <option value="Terkonfirmasi" ${item.status === 'Terkonfirmasi' ? 'selected' : ''}>Terkonfirmasi</option>
                <option value="Selesai" ${item.status === 'Selesai' ? 'selected' : ''}>Selesai</option>
                <option value="Dibatalkan" ${item.status === 'Dibatalkan' ? 'selected' : ''}>Dibatalkan</option>
              </select>
            </td>

            <td class="py-4 px-4 sm:px-6 text-right">
              <div class="flex items-center justify-end gap-1.5">
                <a 
                  href="${waUrl}" 
                  target="_blank" 
                  class="p-2 rounded-lg bg-[#25D366] hover:bg-[#20bd5a] text-white transition-all shadow-sm flex items-center justify-center" 
                  title="Balas &amp; Konfirmasi ke WhatsApp Tamu"
                >
                  <span class="material-symbols-outlined text-[16px]">chat</span>
                </a>

                <button 
                  type="button" 
                  class="view-detail-btn p-2 rounded-lg bg-[#F3ECE3] hover:bg-[#E8DFD5] text-[#1A1816] transition-all flex items-center justify-center cursor-pointer" 
                  data-id="${item.id}"
                  title="Lihat Detail Lengkap"
                >
                  <span class="material-symbols-outlined text-[16px]">visibility</span>
                </button>

                <button 
                  type="button" 
                  class="delete-booking-btn p-2 rounded-lg text-red-500 hover:bg-red-50 transition-all flex items-center justify-center cursor-pointer" 
                  data-id="${item.id}"
                  title="Hapus Reservasi"
                >
                  <span class="material-symbols-outlined text-[16px]">delete</span>
                </button>
              </div>
            </td>
          </tr>
        `;
      });

      tableBody.innerHTML = html;
      attachRowEvents();
    }

    function attachRowEvents() {
      document.querySelectorAll('.status-select').forEach(select => {
        select.addEventListener('change', (e) => {
          const target = e.target as HTMLSelectElement;
          const id = target.getAttribute('data-id');
          const newStatus = target.value as BookingItem['status'];
          const item = bookings.find(b => b.id === id);
          if (item) {
            item.status = newStatus;
            saveBookings();
            updateKPIs();
            renderTable();
          }
        });
      });

      document.querySelectorAll('.view-detail-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          const item = bookings.find(b => b.id === id);
          if (item) openDetailModal(item);
        });
      });

      document.querySelectorAll('.delete-booking-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          if (confirm('Yakin ingin menghapus data reservasi ini dari sistem?')) {
            bookings = bookings.filter(b => b.id !== id);
            saveBookings();
            updateKPIs();
            renderTable();
          }
        });
      });
    }

    // Detail Modal Handling
    const detailModal = document.getElementById('detailModal');
    const closeDetailModalBtn = document.getElementById('closeDetailModalBtn');
    const detailModalContent = document.getElementById('detailModalContent');
    const detailWaBtn = document.getElementById('detailWaBtn');
    const deleteDetailBtn = document.getElementById('deleteDetailBtn');

    function openDetailModal(item: BookingItem) {
      if (detailModalContent) {
        detailModalContent.innerHTML = `
          <div class="p-3.5 rounded-2xl bg-[#FAF2EB] border border-[#7F513C]/20 mb-3">
            <span class="text-[10px] font-bold text-[#8E847C] uppercase tracking-wider block">KODE RESERVASI</span>
            <span class="font-mono text-lg font-bold text-[#7F513C] block">${item.code}</span>
          </div>
          <div class="space-y-2">
            <div class="flex justify-between border-b border-[#E8DFD5] pb-2">
              <span class="text-[#8E847C]">Nama Tamu:</span>
              <span class="font-bold text-[#1A1816]">${item.guestName}</span>
            </div>
            <div class="flex justify-between border-b border-[#E8DFD5] pb-2">
              <span class="text-[#8E847C]">No. WhatsApp:</span>
              <span class="font-bold text-[#1A1816]">${item.guestPhone}</span>
            </div>
            <div class="flex justify-between border-b border-[#E8DFD5] pb-2">
              <span class="text-[#8E847C]">Jadwal Datang:</span>
              <span class="font-bold text-[#1A1816]">${item.dateText} (${item.timeText})</span>
            </div>
            <div class="flex justify-between border-b border-[#E8DFD5] pb-2">
              <span class="text-[#8E847C]">Perawatan:</span>
              <span class="font-bold text-[#1A1816] text-right">${item.services.join(', ')}</span>
            </div>
            <div class="flex justify-between border-b border-[#E8DFD5] pb-2">
              <span class="text-[#8E847C]">Total Estimasi:</span>
              <span class="font-bold text-[#7F513C]">Rp ${item.total.toLocaleString('id-ID')}</span>
            </div>
            <div class="flex justify-between border-b border-[#E8DFD5] pb-2">
              <span class="text-[#8E847C]">Jalur Booking:</span>
              <span class="font-bold text-[#1A1816]">${item.channel === 'dashboard' ? 'Dashboard Admin' : 'WhatsApp OpenGraph Direct'}</span>
            </div>
            <div class="flex justify-between border-b border-[#E8DFD5] pb-2">
              <span class="text-[#8E847C]">Status Saat Ini:</span>
              <span class="font-bold text-[#7F513C]">${item.status}</span>
            </div>
            <div class="pt-1">
              <span class="text-[#8E847C] block mb-1">Catatan Tambahan:</span>
              <p class="p-2.5 rounded-xl bg-[#FBF8F4] border border-[#E8DFD5] text-[#1A1816] text-xs italic">
                ${item.guestNote || 'Tidak ada catatan khusus.'}
              </p>
            </div>
          </div>
        `;
      }

      if (detailWaBtn) {
        const cleanPhone = item.guestPhone.replace(/[^0-9]/g, '');
        const intlPhone = cleanPhone.startsWith('0') ? '62' + cleanPhone.slice(1) : cleanPhone;
        const msg = `Halo Kak ${item.guestName}! Kami dari Sonae Beauty Studio Madiun mengenai kode reservasi ${item.code}...`;
        detailWaBtn.onclick = () => {
          window.open(`https://wa.me/${intlPhone}?text=${encodeURIComponent(msg)}`, '_blank');
        };
      }

      if (deleteDetailBtn) {
        deleteDetailBtn.onclick = () => {
          if (confirm('Hapus reservasi ini?')) {
            bookings = bookings.filter(b => b.id !== item.id);
            saveBookings();
            updateKPIs();
            renderTable();
            detailModal?.classList.add('hidden');
            detailModal?.classList.remove('flex');
          }
        };
      }

      if (detailModal) {
        detailModal.classList.remove('hidden');
        detailModal.classList.add('flex');
      }
    }

    if (closeDetailModalBtn && detailModal) {
      closeDetailModalBtn.addEventListener('click', () => {
        detailModal.classList.add('hidden');
        detailModal.classList.remove('flex');
      });
    }

    // Walkin Modal Handling
    const walkinModal = document.getElementById('walkinModal');
    const openWalkinModalBtn = document.getElementById('openWalkinModalBtn');
    const closeWalkinModalBtn = document.getElementById('closeWalkinModalBtn');
    const cancelWalkinBtn = document.getElementById('cancelWalkinBtn');
    const walkinForm = document.getElementById('walkinForm') as HTMLFormElement;
    const walkinDate = document.getElementById('walkinDate') as HTMLInputElement;

    if (walkinDate) {
      const today = new Date();
      const yyyy = today.getFullYear();
      const mm = String(today.getMonth() + 1).padStart(2, '0');
      const dd = String(today.getDate()).padStart(2, '0');
      walkinDate.value = `${yyyy}-${mm}-${dd}`;
    }

    function openWalkin() {
      if (walkinModal) {
        walkinModal.classList.remove('hidden');
        walkinModal.classList.add('flex');
      }
    }

    function closeWalkin() {
      if (walkinModal) {
        walkinModal.classList.add('hidden');
        walkinModal.classList.remove('flex');
      }
    }

    if (openWalkinModalBtn) openWalkinModalBtn.addEventListener('click', openWalkin);
    if (closeWalkinModalBtn) closeWalkinModalBtn.addEventListener('click', closeWalkin);
    if (cancelWalkinBtn) cancelWalkinBtn.addEventListener('click', closeWalkin);

    if (walkinForm) {
      walkinForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const nameInput = document.getElementById('walkinName') as HTMLInputElement;
        const phoneInput = document.getElementById('walkinPhone') as HTMLInputElement;
        const serviceSelect = document.getElementById('walkinService') as HTMLSelectElement;
        const timeSelect = document.getElementById('walkinTime') as HTMLSelectElement;
        const statusSelect = document.getElementById('walkinStatus') as HTMLSelectElement;
        const noteInput = document.getElementById('walkinNote') as HTMLTextAreaElement;

        const [svcName, svcPrice] = (serviceSelect?.value || 'Layanan|0').split('|');

        const now = new Date();
        const y = now.getFullYear();
        const m = String(now.getMonth() + 1).padStart(2, '0');
        const d = String(now.getDate()).padStart(2, '0');
        const randomNum = Math.floor(1000 + Math.random() * 9000);
        const code = `SN-${y}${m}${d}-${randomNum}`;

        const dateVal = walkinDate?.value ? new Date(walkinDate.value) : new Date();
        const dateFormatted = dateVal.toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

        const newBooking: BookingItem = {
          id: 'bk_' + Date.now(),
          code,
          guestName: nameInput?.value.trim() || 'Tamu Walk-in',
          guestPhone: phoneInput?.value.trim() || '-',
          guestNote: noteInput?.value.trim() || 'Walk-in / Reservasi Kasir',
          services: [svcName],
          total: parseInt(svcPrice || '0', 10),
          dateText: dateFormatted,
          timeText: timeSelect?.value || '13:00 WIB',
          channel: 'dashboard',
          status: (statusSelect?.value as BookingItem['status']) || 'Terkonfirmasi',
          createdAt: new Date().toISOString()
        };

        bookings.unshift(newBooking);
        saveBookings();
        updateKPIs();
        renderTable();
        closeWalkin();
        walkinForm.reset();
        alert(`Reservasi berhasil disimpan dengan kode ${code}!`);
      });
    }

    // Filter Listeners
    statusTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        statusTabs.forEach(t => {
          t.classList.remove('active', 'bg-[#7F513C]', 'text-white');
          t.classList.add('bg-[#F3ECE3]', 'text-[#5C544E]');
        });
        tab.classList.add('active', 'bg-[#7F513C]', 'text-white');
        tab.classList.remove('bg-[#F3ECE3]', 'text-[#5C544E]');

        currentStatusFilter = tab.getAttribute('data-status') || 'all';
        renderTable();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        currentSearchQuery = searchInput.value.trim();
        renderTable();
      });
    }

    if (channelFilter) {
      channelFilter.addEventListener('change', () => {
        currentChannelFilter = channelFilter.value;
        renderTable();
      });
    }

    if (resetFilterBtn) {
      resetFilterBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        if (channelFilter) channelFilter.value = 'all';
        currentSearchQuery = '';
        currentChannelFilter = 'all';
        currentStatusFilter = 'all';

        statusTabs.forEach((t, idx) => {
          if (idx === 0) {
            t.classList.add('active', 'bg-[#7F513C]', 'text-white');
            t.classList.remove('bg-[#F3ECE3]', 'text-[#5C544E]');
          } else {
            t.classList.remove('active', 'bg-[#7F513C]', 'text-white');
            t.classList.add('bg-[#F3ECE3]', 'text-[#5C544E]');
          }
        });

        renderTable();
      });
    }

    // Seed Data Listeners
    const seedDataBtn = document.getElementById('seedDataBtn');
    const emptySeedBtn = document.getElementById('emptySeedBtn');
    function triggerSeed() {
      bookings = [...SAMPLE_BOOKINGS];
      saveBookings();
      updateKPIs();
      renderTable();
      alert('Data contoh reservasi berhasil dimuat!');
    }
    if (seedDataBtn) seedDataBtn.addEventListener('click', triggerSeed);
    if (emptySeedBtn) emptySeedBtn.addEventListener('click', triggerSeed);

    // =================================================================
    // EXPORT HANDLERS: EXCEL (.xlsx), CSV, & JSON
    // =================================================================
    const exportExcelBtn = document.getElementById('exportExcelBtn');
    const toggleExportMenuBtn = document.getElementById('toggleExportMenuBtn');
    const exportMenuDropdown = document.getElementById('exportMenuDropdown');
    const exportMenuXlsx = document.getElementById('exportMenuXlsx');
    const exportMenuCsv = document.getElementById('exportMenuCsv');
    const exportMenuJson = document.getElementById('exportMenuJson');

    // Toggle Dropdown Menu
    if (toggleExportMenuBtn && exportMenuDropdown) {
      toggleExportMenuBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        exportMenuDropdown.classList.toggle('hidden');
      });

      document.addEventListener('click', () => {
        exportMenuDropdown.classList.add('hidden');
      });
    }

    // Function to generate Excel .xlsx
    function downloadExcelXlsx() {
      if (!bookings || bookings.length === 0) {
        alert('Tidak ada data reservasi untuk diekspor.');
        return;
      }

      const rows = bookings.map((b, idx) => ({
        'No': idx + 1,
        'Kode Booking': b.code,
        'Nama Tamu': b.guestName,
        'No. WhatsApp': b.guestPhone,
        'Jadwal Tanggal': b.dateText,
        'Jam Kunjungan': b.timeText,
        'Layanan Perawatan': b.services.join(', '),
        'Estimasi Total Biaya (Rp)': b.total,
        'Jalur Booking': b.channel === 'dashboard' ? 'Dashboard Web Admin' : 'WhatsApp Direct',
        'Status Antrean': b.status,
        'Catatan Khusus': b.guestNote || '-',
        'Waktu Registrasi': new Date(b.createdAt).toLocaleString('id-ID')
      }));

      const worksheet = XLSX.utils.json_to_sheet(rows);

      worksheet['!cols'] = [
        { wch: 6 },
        { wch: 20 },
        { wch: 24 },
        { wch: 18 },
        { wch: 26 },
        { wch: 14 },
        { wch: 38 },
        { wch: 26 },
        { wch: 24 },
        { wch: 22 },
        { wch: 32 },
        { wch: 22 }
      ];

      const workbook = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(workbook, worksheet, 'Data Reservasi Sonae');

      const dateStr = new Date().toISOString().slice(0, 10);
      XLSX.writeFile(workbook, `Data_Reservasi_Sonae_Studio_${dateStr}.xlsx`);
    }

    // Function to generate CSV with UTF-8 BOM
    function downloadCsv() {
      if (!bookings || bookings.length === 0) {
        alert('Tidak ada data reservasi untuk diekspor.');
        return;
      }

      const headers = ['No', 'Kode Booking', 'Nama Tamu', 'No WhatsApp', 'Tanggal', 'Jam', 'Layanan', 'Total Biaya', 'Jalur', 'Status', 'Catatan', 'Waktu Input'];
      const csvRows = [headers.join(',')];

      bookings.forEach((b, idx) => {
        const row = [
          idx + 1,
          `"${b.code}"`,
          `"${(b.guestName || '').replace(/"/g, '""')}"`,
          `"${b.guestPhone}"`,
          `"${b.dateText}"`,
          `"${b.timeText}"`,
          `"${(b.services.join('; ')).replace(/"/g, '""')}"`,
          b.total,
          `"${b.channel}"`,
          `"${b.status}"`,
          `"${(b.guestNote || '-').replace(/"/g, '""')}"`,
          `"${new Date(b.createdAt).toLocaleString('id-ID')}"`
        ];
        csvRows.push(row.join(','));
      });

      const blob = new Blob(['\uFEFF' + csvRows.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Data_Reservasi_Sonae_${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    }

    // Function to generate JSON backup
    function downloadJson() {
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(bookings, null, 2));
      const downloadAnchor = document.createElement('a');
      downloadAnchor.setAttribute("href", dataStr);
      downloadAnchor.setAttribute("download", `reservasi_sonae_${new Date().toISOString().slice(0,10)}.json`);
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
    }

    if (exportExcelBtn) exportExcelBtn.addEventListener('click', downloadExcelXlsx);
    if (exportMenuXlsx) exportMenuXlsx.addEventListener('click', downloadExcelXlsx);
    if (exportMenuCsv) exportMenuCsv.addEventListener('click', downloadCsv);
    if (exportMenuJson) exportMenuJson.addEventListener('click', downloadJson);

    // Print Recap Listener
    const printBtn = document.getElementById('printRecapBtn');
    if (printBtn) {
      printBtn.addEventListener('click', () => {
        window.print();
      });
    }

    // Initial render
    updateKPIs();
    renderTable();
  });
</script>
