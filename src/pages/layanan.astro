---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Daftar Layanan & Transparansi Harga — Sonae Salon Madiun"
  description="Semua harga tercantum jelas tanpa biaya tersembunyi. Layanan Korean smoothing keratin, Japanese gel nail art, lash lift, dan head spa aromaterapi."
  activePage="layanan"
>

  <div class="w-full max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 py-8 sm:py-12">
    
    <!-- Top Editorial Header & Assurance Bar -->
    <div class="w-full bg-[#FAF2EB] rounded-3xl p-6 sm:p-10 border border-[#E8DFD5] mb-10 text-center flex flex-col items-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white text-[#7F513C] text-xs font-bold uppercase tracking-wider mb-3 shadow-sm">
        <span class="size-2 rounded-full bg-[#7F513C]"></span>
        <span>Menu Resmi &amp; Transparansi Penuh</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[#1A1816] max-w-3xl mb-3">
        Daftar Layanan &amp; Transparansi Harga
      </h1>
      <p class="text-sm sm:text-base text-[#5C544E] max-w-2xl mx-auto mb-8 leading-relaxed">
        Semua harga tercantum jelas tanpa biaya tersembunyi. Termasuk konsultasi awal gratis dan sterilisasi instrumen sebelum setiap sesi.
      </p>

      <!-- Trust Badges Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 w-full max-w-4xl">
        <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-white text-left shadow-sm border border-[#E8DFD5]">
          <span class="material-symbols-outlined text-[#7F513C] text-[24px]">verified</span>
          <div>
            <div class="text-xs sm:text-sm font-bold text-[#1A1816]">Harga Final</div>
            <div class="text-[11px] text-[#5C544E]">Tanpa biaya admin / tuslah</div>
          </div>
        </div>

        <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-white text-left shadow-sm border border-[#E8DFD5]">
          <span class="material-symbols-outlined text-[#7F513C] text-[24px]">sanitizer</span>
          <div>
            <div class="text-xs sm:text-sm font-bold text-[#1A1816]">Steril UV-C</div>
            <div class="text-[11px] text-[#5C544E]">Higienis di setiap tamu</div>
          </div>
        </div>

        <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-white text-left shadow-sm border border-[#E8DFD5]">
          <span class="material-symbols-outlined text-[#7F513C] text-[24px]">forum</span>
          <div>
            <div class="text-xs sm:text-sm font-bold text-[#1A1816]">Free Konsultasi</div>
            <div class="text-[11px] text-[#5C544E]">Analisis rambut &amp; kuku</div>
          </div>
        </div>

        <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-white text-left shadow-sm border border-[#E8DFD5]">
          <span class="material-symbols-outlined text-[#7F513C] text-[24px]">local_cafe</span>
          <div>
            <div class="text-xs sm:text-sm font-bold text-[#1A1816]">Welcome Drink</div>
            <div class="text-[11px] text-[#5C544E]">Seduhan herbal artisan</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Sticky Category Filter Tabs (BISA DI-SCROLL LANCAR: TOUCH, MOUSE DRAG & WHEEL) -->
    <div class="sticky top-16 sm:top-20 z-30 bg-[#FBF8F4]/95 backdrop-blur-md py-3 mb-8 border-b border-[#E8DFD5]">
      <div class="relative w-full flex items-center">
        <!-- Tombol Scroll Kiri -->
        <button 
          id="scrollLeftLayanan" 
          type="button"
          aria-label="Scroll Kategori ke Kiri" 
          class="hidden sm:flex absolute -left-2 sm:-left-3 z-20 size-8 rounded-full bg-white/95 backdrop-blur-sm border border-[#E8DFD5] text-[#141414] hover:bg-[#7F513C] hover:text-white items-center justify-center shadow-md transition-all cursor-pointer"
        >
          <span class="material-symbols-outlined text-[18px]">chevron_left</span>
        </button>

        <!-- Scrollable Track -->
        <div 
          id="layananTabsContainer" 
          class="flex items-center gap-2 scroll-touch-x no-scrollbar py-1 px-1 w-full cursor-grab active:cursor-grabbing select-none"
        >
          <button class="layanan-tab active px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold bg-[#7F513C] text-white shadow-sm transition-all shrink-0 cursor-pointer" data-filter="all">
            Semua Layanan
          </button>
          <button class="layanan-tab px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold bg-[#F3ECE3] text-[#5C544E] hover:bg-[#E8DFD5] transition-all shrink-0 cursor-pointer" data-filter="hair">
            Hair Care &amp; Styling
          </button>
          <button class="layanan-tab px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold bg-[#F3ECE3] text-[#5C544E] hover:bg-[#E8DFD5] transition-all shrink-0 cursor-pointer" data-filter="spa">
            Treatment &amp; Hair Spa
          </button>
          <button class="layanan-tab px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold bg-[#F3ECE3] text-[#5C544E] hover:bg-[#E8DFD5] transition-all shrink-0 cursor-pointer" data-filter="nail">
            Nail Art &amp; Care
          </button>
          <button class="layanan-tab px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold bg-[#F3ECE3] text-[#5C544E] hover:bg-[#E8DFD5] transition-all shrink-0 cursor-pointer" data-filter="lash">
            Lash &amp; Beauty Face
          </button>
        </div>

        <!-- Tombol Scroll Kanan -->
        <button 
          id="scrollRightLayanan" 
          type="button"
          aria-label="Scroll Kategori ke Kanan" 
          class="hidden sm:flex absolute -right-2 sm:-right-3 z-20 size-8 rounded-full bg-white/95 backdrop-blur-sm border border-[#E8DFD5] text-[#141414] hover:bg-[#7F513C] hover:text-white items-center justify-center shadow-md transition-all cursor-pointer"
        >
          <span class="material-symbols-outlined text-[18px]">chevron_right</span>
        </button>
