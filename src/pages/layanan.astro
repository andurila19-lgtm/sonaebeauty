<script>
  import { gsap } from 'gsap';

  function initLayanan() {
    gsap.from('.layanan-section', {
      opacity: 0,
      y: 20,
      duration: 0.6,
      stagger: 0.1,
      ease: 'power2.out'
    });

    const container = document.getElementById('layananTabsContainer');
    const btnLeft = document.getElementById('scrollLeftLayanan');
    const btnRight = document.getElementById('scrollRightLayanan');
    const tabs = document.querySelectorAll('.layanan-tab');
    const sections = document.querySelectorAll('.layanan-section');

    // 1. Tombol Navigasi Scroll
    if (container && btnLeft && btnRight) {
      btnLeft.addEventListener('click', () => {
        container.scrollBy({ left: -220, behavior: 'smooth' });
      });
      btnRight.addEventListener('click', () => {
        container.scrollBy({ left: 220, behavior: 'smooth' });
      });

      // 2. Mouse Wheel ke Horizontal Scroll otomatis
      container.addEventListener('wheel', (e) => {
        if (e.deltaY !== 0) {
          e.preventDefault();
          container.scrollLeft += e.deltaY;
        }
      }, { passive: false });

      // 3. Mouse Drag-to-Scroll (Bisa ditarik kursor seperti di smartphone)
      let isDown = false;
      let startX = 0;
      let scrollLeftPos = 0;

      container.addEventListener('mousedown', (e) => {
        isDown = true;
        startX = e.pageX - container.offsetLeft;
        scrollLeftPos = container.scrollLeft;
      });

      window.addEventListener('mouseup', () => {
        isDown = false;
      });

      container.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - container.offsetLeft;
        const walk = (x - startX) * 1.5;
        container.scrollLeft = scrollLeftPos - walk;
      });
    }

    // 4. Tab Click Logic + Auto Scroll into center view
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('active', 'bg-[#7F513C]', 'text-white', 'shadow-sm');
          t.classList.add('bg-[#F3ECE3]', 'text-[#5C544E]');
        });

        tab.classList.add('active', 'bg-[#7F513C]', 'text-white', 'shadow-sm');
        tab.classList.remove('bg-[#F3ECE3]', 'text-[#5C544E]');

        // Scroll tombol aktif ke tengah tampilan secara halus
        tab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });

        const filter = tab.getAttribute('data-filter');
        const visibleSections: HTMLElement[] = [];

        sections.forEach(sec => {
          const el = sec as HTMLElement;
          if (filter === 'all' || el.getAttribute('data-category') === filter) {
            el.style.display = 'block';
            visibleSections.push(el);
          } else {
            el.style.display = 'none';
          }
        });

        if (visibleSections.length > 0) {
          gsap.fromTo(visibleSections, 
            { opacity: 0, y: 15 },
            { opacity: 1, y: 0, duration: 0.35, stagger: 0.08, ease: 'power2.out' }
          );
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initLayanan);
  document.addEventListener('astro:page-load', initLayanan);
</script>
