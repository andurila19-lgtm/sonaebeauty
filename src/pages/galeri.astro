<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination, Autoplay } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/navigation';
  import 'swiper/css/pagination';
  import { gsap } from 'gsap';

  function initGaleri() {
    // 1. Initialize Swiper Featured Showcase
    new Swiper('.galeri-featured-swiper', {
      modules: [Navigation, Pagination, Autoplay],
      slidesPerView: 'auto',
      spaceBetween: 16,
      grabCursor: true,
      loop: true,
      autoplay: {
        delay: 3500,
        disableOnInteraction: false,
        pauseOnMouseEnter: true
      },
      navigation: {
        prevEl: '#galeriSwiperPrev',
        nextEl: '#galeriSwiperNext'
      },
      pagination: {
        el: '.galeri-featured-swiper .swiper-pagination',
        clickable: true
      }
    });

    // 2. GSAP entrance animation for gallery cards
    gsap.from('.galeri-item', {
      opacity: 0,
      y: 20,
      duration: 0.6,
      stagger: 0.08,
      ease: 'power2.out'
    });

    // 3. Filter Tabs Horizontal Scroll & Logic
    const container = document.getElementById('galeriFilterBar');
    const btnLeft = document.getElementById('scrollLeftGaleri');
    const btnRight = document.getElementById('scrollRightGaleri');
    const tabs = document.querySelectorAll('.galeri-tab');
    const items = document.querySelectorAll('.galeri-item');

    if (container && btnLeft && btnRight) {
      btnLeft.addEventListener('click', () => {
        container.scrollBy({ left: -220, behavior: 'smooth' });
      });
      btnRight.addEventListener('click', () => {
        container.scrollBy({ left: 220, behavior: 'smooth' });
      });

      container.addEventListener('wheel', (e) => {
        if (e.deltaY !== 0) {
          e.preventDefault();
          container.scrollLeft += e.deltaY;
        }
      }, { passive: false });

      let isDown = false;
      let startX = 0;
      let scrollLeftPos = 0;

      container.addEventListener('mousedown', (e) => {
        isDown = true;
        startX = e.pageX - container.offsetLeft;
        scrollLeftPos = container.scrollLeft;
      });

      window.addEventListener('mouseup', () => {
        isDown = false;
      });

      container.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - container.offsetLeft;
        const walk = (x - startX) * 1.5;
        container.scrollLeft = scrollLeftPos - walk;
      });
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('active', 'bg-[#7F513C]', 'text-white', 'shadow-sm');
          t.classList.add('bg-[#F3ECE3]', 'text-[#5C544E]');
        });
        tab.classList.add('active', 'bg-[#7F513C]', 'text-white', 'shadow-sm');
        tab.classList.remove('bg-[#F3ECE3]', 'text-[#5C544E]');

        tab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });

        const filter = tab.getAttribute('data-filter');
        const visibleItems: HTMLElement[] = [];

        items.forEach(it => {
          const el = it as HTMLElement;
          const cat = el.getAttribute('data-category');
          if (filter === 'all' || cat === filter) {
            el.style.display = 'block';
            visibleItems.push(el);
          } else {
            el.style.display = 'none';
          }
        });

        if (visibleItems.length > 0) {
          gsap.fromTo(visibleItems, 
            { opacity: 0, y: 15 },
            { opacity: 1, y: 0, duration: 0.4, stagger: 0.05, ease: 'power2.out' }
          );
        }
      });
    });

    // 4. Modal Zoom Logic
    const modal = document.getElementById('galeriModal');
    const closeBtn = document.getElementById('closeGaleriModal');
    const mImg = document.getElementById('gModalImg') as HTMLImageElement;
    const mTitle = document.getElementById('gModalTitle');
    const mDesc = document.getElementById('gModalDesc');

    items.forEach(it => {
      it.addEventListener('click', () => {
        const img = it.getAttribute('data-img') || '';
        const title = it.getAttribute('data-title') || '';
        const desc = it.getAttribute('data-desc') || '';

        if (mImg) mImg.src = img;
        if (mTitle) mTitle.textContent = title;
        if (mDesc) mDesc.textContent = desc;
        if (modal) {
          modal.classList.remove('hidden');
          gsap.fromTo(modal, { opacity: 0 }, { opacity: 1, duration: 0.25 });
        }
      });
    });

    if (closeBtn && modal) {
      closeBtn.onclick = () => modal.classList.add('hidden');
      modal.onclick = (e) => {
        if (e.target === modal) modal.classList.add('hidden');
      };
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGaleri);
  } else {
    initGaleri();
  }
  document.addEventListener('astro:page-load', initGaleri);
</script>
