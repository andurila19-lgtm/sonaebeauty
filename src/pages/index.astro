---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Sonae Salon — Salon Rambut & Kecantikan Madiun: Smoothing, Nail Art, Lash Lift"
  description="Selamat datang di Sonae Salon Madiun. Kami berkomitmen memberikan layanan terbaik mulai dari Korean smoothing, Japanese nail art, hingga keratin lash lift. #semuaberhakcakep"
  activePage="beranda"
>

  <!-- ================================================================= -->
  <!-- 1. HERO SECTION (PERSIS TATA LETAK MOBILE MOIR SALON) -->
  <!-- ================================================================= -->
  <section id="hero" class="relative w-full px-4 sm:px-8 lg:px-12 pt-6 sm:pt-10 pb-8 sm:pb-12 overflow-hidden">
    
    <!-- Top Subtle Gradient Transition from Header -->
    <div class="absolute top-0 left-0 right-0 h-32 bg-gradient-to-b from-[#BFAF86]/30 via-[#BFAF86]/5 to-transparent pointer-events-none"></div>

    <div class="relative w-full flex flex-col md:flex-row items-center md:items-end justify-between gap-6 md:gap-4">
      
      <!-- Left Side: Editorial Typography (Mentok lurus persis dengan Logo Navbar di kiri) -->
      <div class="relative z-10 w-full md:w-[48%] lg:w-[44%] xl:w-[42%] flex flex-col pt-2 lg:pt-4 pb-2 md:pb-6">
        
        <!-- Heading & Slogan -->
        <hgroup class="flex flex-col mb-3">
          <h1 class="font-sans text-[32px] sm:text-[42px] lg:text-[54px] font-extrabold leading-[1.03] tracking-[-0.035em] text-[#141414] mb-1.5">
            Selamat Datang di<br/>Sonae Salon
          </h1>
          <h2 class="text-2xl sm:text-[28px] lg:text-[32px] font-sans tracking-tight text-[#141414] font-normal mb-1">
            #semua<span class="font-bold">berhak</span>cakep
          </h2>
        </hgroup>

        <!-- Narrative Paragraph (Kompak max-w-[440px] agar nyaman dibaca) -->
        <p class="text-sm sm:text-[15px] text-[#2E2E2E] leading-relaxed mb-3 text-justify max-w-[440px]">
          Semua orang berhak menemukan versi terbaik dari dirinya. Kami berkomitmen memberikan layanan terbaik dan hasil yang memuaskan agar Anda merasa lebih percaya diri. Sejak langkah pertama Anda di salon kami, kepuasan Anda menjadi prioritas utama kami.
        </p>

        <!-- MOBILE HERO IMAGE (Tepat di bawah teks pada mobile) -->
        <div class="block md:hidden w-full my-3">
          <img 
            src="/images/headline_models.webp" 
            alt="Model Perawatan Rambut Cantik di Sonae Beauty Studio Madiun" 
            class="w-full h-auto object-contain mx-auto"
          />
        </div>

        <!-- QUICK BOOKING BAR (Kotak Search + Tombol Cari Booking) -->
        <div id="heroBookingBar" class="w-full max-w-[440px] mt-2 sm:mt-5 rounded-2xl bg-[#BFAF86] p-3 sm:p-3.5 shadow-xl flex items-center gap-2.5">
          <button 
            id="openSearchBtn" 
            aria-label="Cari Booking" 
            title="Cari Booking" 
            class="size-11 rounded-xl bg-white text-[#141414] flex items-center justify-center shrink-0 shadow-sm transition-all duration-200 active:opacity-80 hover:bg-neutral-50 cursor-pointer"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="size-5 stroke-[#141414]">
              <path d="M11.5 21C16.7467 21 21 16.7467 21 11.5C21 6.25329 16.7467 2 11.5 2C6.25329 2 2 6.25329 2 11.5C2 16.7467 6.25329 21 11.5 21Z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M22 22L20 20" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <a 
            href="/booking" 
            class="flex-1 h-11 rounded-xl bg-white text-[#141414] font-bold text-sm sm:text-base flex items-center justify-center shadow-sm transition-all duration-200 active:opacity-80 hover:bg-neutral-50 text-center"
          >
            Cari Booking
          </a>
        </div>

        <!-- Rating Proof Badge (Desktop) -->
        <div id="heroRatingBadge" class="hidden md:flex items-center gap-2.5 text-xs tracking-wider text-[#5C544E] font-medium mt-4">
          <div class="flex items-center text-[#C68D37]">
            <span class="material-symbols-outlined text-[17px]" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined text-[17px]" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined text-[17px]" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined text-[17px]" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined text-[17px]" style="font-variation-settings: 'FILL' 1;">star</span>
          </div>
          <span class="font-bold text-[#1A1816]">4.9 / 5.0</span>
          <span class="opacity-60">•</span>
          <span>752 Google Reviews Asli</span>
        </div>

      </div>

      <!-- Right Side: Natural Floating Photography (Desktop - Mentok lurus persis dengan tombol Buat Janji di kanan, nempel ke dasar section) -->
      <div id="heroPhotoContainer" class="relative hidden md:flex w-full md:w-[52%] lg:w-[56%] xl:w-[58%] items-end justify-end self-end">
        <img 
          src="/images/headline_models.webp" 
          alt="Model Perawatan Rambut Cantik di Sonae Beauty Studio Madiun" 
          class="w-full max-w-2xl lg:max-w-3xl xl:max-w-4xl 2xl:max-w-5xl h-auto object-contain object-bottom-right drop-shadow-md select-none pointer-events-none transition-opacity duration-500 hover:opacity-95 -mb-1"
        />
      </div>

    </div>

    <!-- =============================================================== -->
    <!-- COMPACT HORIZONTAL GRID: "OLEH AHLINYA" & "HARGA TERJANGKAU" (SATU BARIS, SEJAJAR & BORDERLESS) -->
    <!-- =============================================================== -->
    <div id="keunggulan" class="w-full mt-8 sm:mt-12 pt-6 sm:pt-8 border-t border-[#A89870]/20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10 items-center">
        
        <!-- Sisi Kiri: Foto Stylist + Teks Oleh Ahlinya -->
        <div class="flex items-center gap-4 sm:gap-6">
          <img 
            src="/images/oleh_ahlinya.webp" 
            alt="Terapis Profesional Sonae Salon Madiun" 
            class="w-28 sm:w-36 md:w-44 lg:w-48 h-auto object-contain shrink-0 select-none drop-shadow-sm"
          />
          <div class="flex flex-col">
            <h3 class="font-sans text-lg sm:text-xl lg:text-2xl font-bold text-[#141414] mb-2">
              Oleh Ahlinya
            </h3>
            <p class="text-xs sm:text-[13px] lg:text-sm text-[#2E2E2E] leading-relaxed text-justify">
              Semua perawatan dikerjakan oleh profesional yang berdedikasi pada keunggulan. Kami hanya menggunakan produk berkualitas premium bersertifikasi BPOM dan terus mengikuti tren serta perkembangan terbaru di industri kecantikan, demi perawatan dan hasil terbaik untuk pelanggan kami.
            </p>
          </div>
        </div>

        <!-- Sisi Kanan: Teks Harga Terjangkau + Foto Model Rambut -->
        <div class="flex items-center gap-4 sm:gap-6">
          <div class="flex flex-col order-2 lg:order-1">
            <h3 class="font-sans text-lg sm:text-xl lg:text-2xl font-bold text-[#141414] mb-2">
              Harga Terjangkau
            </h3>
            <p class="text-xs sm:text-[13px] lg:text-sm text-[#2E2E2E] leading-relaxed text-justify">
              Yang terbaik, layanan kami dihargai dengan bijak dan transparan sehingga perawatan diri berkualitas terjangkau untuk semua. Di Sonae Beauty Studio, tak perlu ragu—karena Anda pantas mendapatkannya. Perjalanan Anda menuju percaya diri dan tampil cantik dimulai di sini. Selamat datang di pengalaman Sonae!
            </p>
          </div>
          <img 
            src="/images/harga_terjangkau.webp" 
            alt="Perawatan Rambut Harga Terjangkau di Sonae Salon Madiun" 
            class="w-28 sm:w-36 md:w-44 lg:w-48 h-auto object-contain shrink-0 order-1 lg:order-2 select-none drop-shadow-sm"
          />
        </div>

      </div>
    </div>

  </section>

  <!-- ================================================================= -->
  <!-- LADIES ROOM SECTION (RUANG PRIVAT & HIJAB-FRIENDLY - BORDERLESS) -->
  <!-- ================================================================= -->
  <section id="ladies-room" class="w-full max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 py-10">
    <div class="ladies-room-card flex flex-col sm:flex-row items-stretch rounded-3xl bg-[#F4EFEA] overflow-hidden shadow-soft-card group">
      <div class="w-full sm:w-1/2 aspect-[16/10] sm:aspect-auto overflow-hidden shrink-0">
        <img 
          src="/images/ladies_room.webp" 
          alt="Ladies Room Privat & Hijab-Friendly di Sonae Beauty Studio Madiun" 
          class="w-full h-full object-cover object-center transition-opacity duration-300 group-hover:opacity-95"
        />
      </div>
      <div class="p-6 sm:p-10 md:p-12 flex flex-col justify-center flex-1">
        <span class="inline-block w-fit px-3 py-1 rounded-full bg-[#E5DDD2] text-[#7F513C] font-bold text-[11px] tracking-wider uppercase mb-3">
          100% HIJAB &amp; PRIVAT FRIENDLY
        </span>
        <h3 class="font-serif text-2xl lg:text-3xl font-bold text-[#141414] mb-3">
          Ladies Room — Ruang Perawatan Privat Khusus Wanita
        </h3>
        <p class="text-sm text-[#444444] leading-relaxed mb-6 text-justify">
          Nikmati perawatan rambut dan relaksasi paripurna tanpa rasa was-was. Sonae Beauty Studio menghadirkan Ladies Room tertutup khusus wanita, dilayani oleh terapis wanita profesional dalam suasana hangat, steril, dan tenang.
        </p>
        <div class="grid grid-cols-2 gap-3 mb-6 text-xs font-semibold text-[#141414]">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[#7F513C] text-[18px]">verified</span>
            <span>Bebas Pandangan Luar</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[#7F513C] text-[18px]">verified</span>
            <span>Terapis Wanita Ahli</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[#7F513C] text-[18px]">verified</span>
            <span>Aromaterapi Menenangkan</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[#7F513C] text-[18px]">verified</span>
            <span>Ruang Cuci Rambut Privat</span>
          </div>
        </div>
        <div>
          <a 
            href="/booking" 
            class="inline-flex items-center justify-center px-6 py-3 rounded-xl bg-[#7F513C] text-white font-bold text-xs hover:bg-[#633B2A] shadow-sm transition-all"
          >
            Reservasi Slot Ladies Room
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================= -->
  <!-- 2. GALLERY SECTION (INTERACTIVE FILTER & ZOOM - BORDERLESS) -->
  <!-- ================================================================= -->
  <section id="galeri" class="w-full max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 py-12">
    <div class="w-full rounded-3xl bg-white p-6 sm:p-10 shadow-soft-card">
      
      <!-- Gallery Header Banner -->
      <div class="w-full rounded-2xl bg-[#EFE8DF] p-6 sm:p-10 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-8">
        <div class="max-w-xl">
          <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[#1A1816] mb-3">
            Galeri Sonae Beauty Studio
          </h2>
          <p class="text-sm sm:text-base text-[#5C544E]">
            Temukan kekuatan transformasi Sonae Beauty Studio, jelajahi beragam gaya, dan temukan tampilan terbaik Anda.
          </p>
        </div>

        <!-- Dropdown Category Filter -->
        <div class="w-full md:w-64">
          <label class="text-xs font-semibold uppercase tracking-wider text-[#5C544E] block mb-1.5">Kategori Galeri</label>
          <div class="relative">
            <select id="galleryFilterSelect" class="w-full appearance-none rounded-xl bg-white px-4 py-3 font-sans text-sm font-medium text-[#1A1816] focus:outline-none focus:ring-2 focus:ring-[#7F513C] cursor-pointer shadow-sm">
              <option value="all">Semua Kategori</option>
              <option value="hair">Hair Treatment &amp; Styling</option>
              <option value="nail">Japanese Nail Art</option>
              <option value="lash">Lash Lift &amp; Facial Spa</option>
              <option value="studio">Sanctuary Studio Interior</option>
            </select>
            <span class="material-symbols-outlined pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-[#5C544E] text-[20px]">
              expand_more
            </span>
          </div>
        </div>
      </div>

      <!-- SWIPER QUICK PREVIEW CAROUSEL -->
      <div class="mb-8">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-bold uppercase tracking-wider text-[#7F513C]">SOROTAN KARYA TERBARU</span>
          <div class="flex items-center gap-2">
            <button id="homeGaleriPrev" aria-label="Sebelumnya" class="size-8 rounded-full bg-[#FAF2EB] hover:bg-[#7F513C] hover:text-white text-[#1A1816] flex items-center justify-center transition-colors cursor-pointer">
              <span class="material-symbols-outlined text-[16px]">chevron_left</span>
            </button>
            <button id="homeGaleriNext" aria-label="Berikutnya" class="size-8 rounded-full bg-[#FAF2EB] hover:bg-[#7F513C] hover:text-white text-[#1A1816] flex items-center justify-center transition-colors cursor-pointer">
              <span class="material-symbols-outlined text-[16px]">chevron_right</span>
            </button>
          </div>
        </div>
        <div class="swiper home-galeri-swiper w-full rounded-2xl overflow-hidden">
          <div class="swiper-wrapper">
            <div class="swiper-slide !w-auto">
              <div class="w-[220px] sm:w-[260px] aspect-[4/5] rounded-xl overflow-hidden relative group bg-[#F3ECE3]">
                <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuDXtN5iHIGhC6Juy-Up5-Cbr06SIg-gu4fPCNAGlq3QcxcXMM6EnKRBJaZWxDfTs8_pjTikDCAfM8M4CANajFU7OwLLJLu4ROWoqNbD57yQHC1qOKbXXdxndzJUgJCpfngpVNljvKS8gqzbSvIEoCbiOck0hQAfClbmmJqVyjyemlQpad71dNjxg4gtyDAwrW0gJR6T1Cx79Cd0Sxsd50X9GFY82dgehk3aLEJLUlefGbwXJOG71WvobQ" alt="Korean Smoothing" class="w-full h-full object-cover transition-opacity duration-300 group-hover:opacity-95" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex flex-col justify-end p-3 text-white">
                  <span class="text-[10px] text-[#F6ECE6] uppercase font-bold">Hair</span>
                  <p class="text-xs font-bold">Korean Smoothing Silk</p>
                </div>
              </div>
            </div>
            <div class="swiper-slide !w-auto">
              <div class="w-[220px] sm:w-[260px] aspect-[4/5] rounded-xl overflow-hidden relative group bg-[#F3ECE3]">
                <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuBPrn_pyz6E9h9STC6Nt_R1gNRrTYHfb5jw79JbR7SaXgyqn6QUN6nkhD6iz7WMYsG80_LuHCTWaUNU52WqbiBpYRzoxF26jFAmw8-6w2aaqd_j5wg2EM7rDqqyMa1kp6ShY9tyVxl107lJYKb3t1fMJ0BGpkqe9CWscLLJBmnYeIbmmVrpOchPkKzTBlFz1vxw4oDTnj1N5oUqyIuDcPaDWiy5VWpS_cerFISJJ57LW7Kew98jd_qBIw" alt="Japanese Nail Art" class="w-full h-full object-cover transition-opacity duration-300 group-hover:opacity-95" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex flex-col justify-end p-3 text-white">
                  <span class="text-[10px] text-[#F6ECE6] uppercase font-bold">Nails</span>
                  <p class="text-xs font-bold">Japanese Gel Minimalist</p>
                </div>
              </div>
            </div>
            <div class="swiper-slide !w-auto">
              <div class="w-[220px] sm:w-[260px] aspect-[4/5] rounded-xl overflow-hidden relative group bg-[#F3ECE3]">
                <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuAGMVVTUUs8R0mKOqbEvEGCY0S6yCb9TpsXiZ9ZrJrL-IPXb_VayqntABcIx5C0tvtJNVMDZVRTcYBsAcBuEAyc1NKrfcemX3MoA0hLGd3Sfc7sU1uOol_yWc-AfTIeGoVSZi2J5V5ymkV3WMFs0VCpZQxXXhIs3FaQ2cEpMKQWLB_c5n4dYZhKBU6AcZWepeG-BOVx6nw20tNFn5ZMYwbcMIDdD29njTzNfExSvDxTMxYPJJ4eBmmJOQ" alt="Lash Lift" class="w-full h-full object-cover transition-opacity duration-300 group-hover:opacity-95" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex flex-col justify-end p-3 text-white">
                  <span class="text-[10px] text-[#F6ECE6] uppercase font-bold">Lashes</span>
                  <p class="text-xs font-bold">Keratin Fan Lash Lift</p>
                </div>
              </div>
            </div>
            <div class="swiper-slide !w-auto">
              <div class="w-[220px] sm:w-[260px] aspect-[4/5] rounded-xl overflow-hidden relative group bg-[#F3ECE3]">
                <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuD8TFpqAihLlZzIZdZJPUwO0q7LEaUgzHW3P_e7mBYWN93PXjt8dBhqKdDG51afyNV-0Mt2AMVPTPSprdSzdUpDFwum1KCT6jTIjBomHS5LMR-3aAtifDvNzFYz36ZuEE2L5vudXNFxE3jwhyAdIHjiiz4Oib50pk9rlSfn9aqV8puC6nKtYggSozaERb5Vly1IGcGD_iAIET2e-t7N0txqI344dTJDyKXQ2Ty_mlhH8vWig_D4D6PLVQ" alt="Hair Flow" class="w-full h-full object-cover transition-opacity duration-300 group-hover:opacity-95" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex flex-col justify-end p-3 text-white">
                  <span class="text-[10px] text-[#F6ECE6] uppercase font-bold">Hair</span>
                  <p class="text-xs font-bold">Silky Hair Transformation</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Hint Instruction -->
      <div class="flex items-center justify-between text-xs sm:text-sm text-[#5C544E] mb-6">
        <p class="flex items-center gap-1.5 font-medium">
          <span class="material-symbols-outlined text-[18px] text-[#7F513C]">touch_app</span>
          <span>Klik foto untuk memperbesar tampilan</span>
        </p>
        <span id="galleryCount" class="text-xs font-semibold text-[#7F513C]">Menampilkan 8 Karya</span>
      </div>

      <!-- Gallery Photo Grid -->
      <div id="galleryGrid" class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
        
        <div class="gallery-item group relative aspect-square rounded-2xl overflow-hidden bg-[#F3ECE3] shadow-sm cursor-pointer" data-category="hair" data-img="https://lh3.googleusercontent.com/aida-public/AB6AXuDXtN5iHIGhC6Juy-Up5-Cbr06SIg-gu4fPCNAGlq3QcxcXMM6EnKRBJaZWxDfTs8_pjTikDCAfM8M4CANajFU7OwLLJLu4ROWoqNbD57yQHC1qOKbXXdxndzJUgJCpfngpVNljvKS8gqzbSvIEoCbiOck0hQAfClbmmJqVyjyemlQpad71dNjxg4gtyDAwrW0gJR6T1Cx79Cd0Sxsd50X9GFY82dgehk3aLEJLUlefGbwXJOG71WvobQ" data-title="Korean Smoothing Keratin Silk" data-type="Hair Treatment">
          <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuDXtN5iHIGhC6Juy-Up5-Cbr06SIg-gu4fPCNAGlq3QcxcXMM6EnKRBJaZWxDfTs8_pjTikDCAfM8M4CANajFU7OwLLJLu4ROWoqNbD57yQHC1qOKbXXdxndzJUgJCpfngpVNljvKS8gqzbSvIEoCbiOck0hQAfClbmmJqVyjyemlQpad71dNjxg4gtyDAwrW0gJR6T1Cx79Cd0Sxsd50X9GFY82dgehk3aLEJLUlefGbwXJOG71WvobQ" alt="Korean Smoothing Keratin" class="w-full h-full object-cover transition-opacity duration-300 group-hover:opacity-95"/>
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4 text-white">
            <div>
              <p class="text-[11px] uppercase tracking-wider font-semibold text-[#F6ECE6]">Hair Care</p>
              <p class="font-serif text-sm font-bold">Korean Smoothing Keratin</p>
            </div>
          </div>
        </div>

        <div class="gallery-item group relative aspect-square rounded-2xl overflow-hidden bg-[#F3ECE3] shadow-sm cursor-pointer" data-category="nail" data-img="https://lh3.googleusercontent.com/aida-public/AB6AXuBPrn_pyz6E9h9STC6Nt_R1gNRrTYHfb5jw79JbR7SaXgyqn6QUN6nkhD6iz7WMYsG80_LuHCTWaUNU52WqbiBpYRzoxF26jFAmw8-6w2aaqd_j5wg2EM7rDqqyMa1kp6ShY9tyVxl107lJYKb3t1fMJ0BGpkqe9CWscLLJBmnYeIbmmVrpOchPkKzTBlFz1vxw4oDTnj1N5oUqyIuDcPaDWiy5VWpS_cerFISJJ57LW7Kew98jd_qBIw" data-title="Japanese Gel Nail Art Minimalis" data-type="Nail Care & Art">
          <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuBPrn_pyz6E9h9STC6Nt_R1gNRrTYHfb5jw79JbR7SaXgyqn6QUN6nkhD6iz7WMYsG80_LuHCTWaUNU52WqbiBpYRzoxF26jFAmw8-6w2aaqd_j5wg2EM7rDqqyMa1kp6ShY9tyVxl107lJYKb3t1fMJ0BGpkqe9CWscLLJBmnYeIbmmVrpOchPkKzTBlFz1vxw4oDTnj1N5oUqyIuDcPaDWiy5VWpS_cerFISJJ57LW7Kew98jd_qBIw" alt="Japanese Gel Nail Art" class="w-full h-full object-cover transition-opacity duration-300 group-hover:opacity-95"/>
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4 text-white">
            <div>
              <p class="text-[11px] uppercase tracking-wider font-semibold text-[#F6ECE6]">Nail Art</p>
              <p class="font-serif text-sm font-bold">Japanese Gel Ornaments</p>
            </div>
