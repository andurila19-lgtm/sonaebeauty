<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination, Autoplay } from 'swiper/modules';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initHome() {
    // 1. Swiper for Gallery Highlights
    new Swiper('.home-galeri-swiper', {
      modules: [Navigation, Autoplay],
      slidesPerView: 'auto',
      spaceBetween: 16,
      grabCursor: true,
      loop: true,
      autoplay: {
        delay: 3000,
        disableOnInteraction: false,
        pauseOnMouseEnter: true
      },
      navigation: {
        prevEl: '#homeGaleriPrev',
        nextEl: '#homeGaleriNext'
      }
    });

    // 2. Swiper for Customer Testimonials
    new Swiper('.testi-swiper', {
      modules: [Navigation, Pagination, Autoplay],
      slidesPerView: 1,
      spaceBetween: 30,
      grabCursor: true,
      loop: true,
      autoplay: {
        delay: 4500,
        disableOnInteraction: false,
        pauseOnMouseEnter: true
      },
      navigation: {
        prevEl: '#prevTestiBtn',
        nextEl: '#nextTestiBtn'
      },
      pagination: {
        el: '.testi-swiper .swiper-pagination',
        clickable: true
      }
    });

    // 3. GSAP Smooth Intro Animation (Safe & Resilient)
    const heroImg = document.querySelector('#heroPhotoContainer img') as HTMLElement;
    if (heroImg) {
      gsap.fromTo(heroImg, 
        { opacity: 0, y: 20 }, 
        { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' }
      );
    }

    const bookingBar = document.getElementById('heroBookingBar');
    if (bookingBar) {
      gsap.fromTo(bookingBar, 
        { opacity: 0, y: 15 }, 
        { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out', delay: 0.15 }
      );
    }

    // 4. GSAP ScrollTrigger Effects
    gsap.from('.lokasi-card', {
      opacity: 0,
      y: 40,
      duration: 1,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: '#lokasi',
        start: 'top 80%'
      }
    });

    gsap.from('.testi-card', {
      opacity: 0,
      y: 30,
      duration: 1,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: '#testimoni',
        start: 'top 80%'
      }
    });

    // 5. Search Booking Modal
    const openSearchBtn = document.getElementById('openSearchBtn');
    const closeSearchBtn = document.getElementById('closeSearchBtn');
    const searchModal = document.getElementById('searchBookingModal');
    const doSearchBtn = document.getElementById('doSearchBtn');
    const searchInput = document.getElementById('bookingSearchInput') as HTMLInputElement;
    const searchResult = document.getElementById('searchResult');

    if (openSearchBtn && searchModal) {
      openSearchBtn.onclick = () => {
        searchModal.classList.remove('hidden');
        gsap.fromTo(searchModal, { opacity: 0 }, { opacity: 1, duration: 0.25 });
      };
    }
    if (closeSearchBtn && searchModal) {
      closeSearchBtn.onclick = () => {
        searchModal.classList.add('hidden');
        if (searchResult) searchResult.classList.add('hidden');
      };
    }
    if (doSearchBtn && searchInput && searchResult) {
      doSearchBtn.onclick = () => {
        if (searchInput.value.trim()) {
          searchResult.classList.remove('hidden');
          gsap.fromTo(searchResult, { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.3 });
        }
      };
    }

    // 6. Photo Lightbox Modal
    const photoModal = document.getElementById('photoModal');
    const closePhotoModalBtn = document.getElementById('closePhotoModalBtn');
    const modalImg = document.getElementById('modalImg') as HTMLImageElement;
    const modalTitle = document.getElementById('modalTitle');
    const modalCategory = document.getElementById('modalCategory');

    document.querySelectorAll('.gallery-item').forEach(item => {
      item.addEventListener('click', () => {
        const img = item.getAttribute('data-img') || '';
        const title = item.getAttribute('data-title') || '';
        const cat = item.getAttribute('data-type') || '';
        if (modalImg) modalImg.src = img;
        if (modalTitle) modalTitle.textContent = title;
        if (modalCategory) modalCategory.textContent = cat;
        if (photoModal) {
          photoModal.classList.remove('hidden');
          gsap.fromTo(photoModal, { opacity: 0 }, { opacity: 1, duration: 0.25 });
        }
      });
    });

    if (closePhotoModalBtn && photoModal) {
      closePhotoModalBtn.onclick = () => photoModal.classList.add('hidden');
      photoModal.onclick = (e) => {
        if (e.target === photoModal) photoModal.classList.add('hidden');
      };
    }

    // 7. Gallery Category Filter
    const filterSelect = document.getElementById('galleryFilterSelect') as HTMLSelectElement;
    const galleryCount = document.getElementById('galleryCount');
    if (filterSelect) {
      filterSelect.onchange = () => {
        const val = filterSelect.value;
        let count = 0;
        const visibleItems: HTMLElement[] = [];
        document.querySelectorAll('.gallery-item').forEach(item => {
          const el = item as HTMLElement;
          const cat = el.getAttribute('data-category');
          if (val === 'all' || cat === val) {
            el.style.display = 'block';
            visibleItems.push(el);
            count++;
          } else {
            el.style.display = 'none';
          }
        });
        if (galleryCount) galleryCount.textContent = `Menampilkan ${count} Karya`;
        if (visibleItems.length > 0) {
          gsap.fromTo(visibleItems, 
            { opacity: 0, y: 15 }, 
            { opacity: 1, y: 0, duration: 0.4, stagger: 0.05, ease: 'power2.out' }
          );
        }
      };
    }
  }

  document.addEventListener('DOMContentLoaded', initHome);
  document.addEventListener('astro:page-load', initHome);
</script>
